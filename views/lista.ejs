<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Devs</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!--Cabera-->
   <header>
       <h1>Lista de Devs</h1>
    </header> 
    <!--Cuerpo de la pagina -->
    <main>
        <ul>
            <% data.forEach(item => { %>
               <li><a href="/lista/<%= item.id %>"><%= item.nombre %></a></li> 
            <% }); %>
        </ul>
    </main>
    
    
</body>
</html>